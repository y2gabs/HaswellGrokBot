# Public URL of this app (no trailing slash). Must match HASWELL_BOTS_APP_URL in wp-config.php.
APP_URL=https://bots.example.com

# The WordPress network's main site, which serves the "Connect your website" page.
WP_NETWORK_URL=https://example.com

# Same value as HASWELL_BOTS_CLIENT_SECRET in wp-config.php (32+ random characters).
HASWELL_BOTS_CLIENT_SECRET=

# Encrypts the session cookie. 32+ random characters: openssl rand -base64 48
SESSION_SECRET=

# DeepSeek orchestrates both bots and writes the articles.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional: point at an OpenAI-compatible proxy or a test double.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional: a different model for article writing (e.g. deepseek-v4-pro).
# DEEPSEEK_WRITER_MODEL=

# Featured images: OpenAI (preferred, cheapest gpt-image tier) or Gemini.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1-mini
# OPENAI_IMAGE_QUALITY=low
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Where image candidates wait until one is picked (cleared after a day).
DATA_DIR=.data
