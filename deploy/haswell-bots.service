# /etc/systemd/system/haswell-bots.service — HestiaCP layout (see README).
[Unit]
Description=Haswell Bots (Next.js)
After=network.target

[Service]
User=haswell
WorkingDirectory=/home/haswell/web/bots.haswell.app/private/app
EnvironmentFile=/home/haswell/web/bots.haswell.app/private/.env
Environment=PORT=3200
Environment=HOSTNAME=127.0.0.1
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
